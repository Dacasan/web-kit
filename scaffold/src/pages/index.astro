---
import BaseLayout from '@agenciaweb/kit/layouts/BaseLayout.astro';
import Section from '@agenciaweb/kit/components/Section.astro';
import Card from '@agenciaweb/kit/components/blocks/Card.astro';
import Text from '@agenciaweb/kit/components/blocks/Text.astro';
import { site, PRIMARY_CTA, whatsappHref } from '../data/site';
import '../styles/index.css';
---

<BaseLayout title={`${site.name} — home`} description={`Placeholder value proposition of ${site.name} in one sentence.`} path="/">
  <Section>
    <div class="row">
      <div class="col-12 col-8">
        <Card>
          <Text level={1} title={site.name} />
          <Text>El h1 de arriba es el que lleva el peso: repite el lenguaje del anuncio que trajo el clic (guía demo).</Text>
          <p><a class="btn" href={whatsappHref}>{PRIMARY_CTA}</a></p>
        </Card>
      </div>
    </div>
  </Section>
</BaseLayout>
