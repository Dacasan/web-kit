---
import BaseLayout from '@agenciaweb/kit/layouts/BaseLayout.astro';
import Section from '@agenciaweb/kit/components/Section.astro';
import Card from '@agenciaweb/kit/components/blocks/Card.astro';
import Text from '@agenciaweb/kit/components/blocks/Text.astro';
import '../styles/index.css';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist." noindex>
  <Section>
    <div class="col-12">
      <Card>
        <Text level={1} title="404 — Page not found" />
        <Text text='Go back to the <a href="/">home page</a> or message us on WhatsApp.' />
      </Card>
    </div>
  </Section>
</BaseLayout>
