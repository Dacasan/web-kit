---
import BaseLayout from '@agenciaweb/kit/layouts/BaseLayout.astro';
import Section from '@agenciaweb/kit/components/Section.astro';
import Card from '@agenciaweb/kit/components/blocks/Card.astro';
import Text from '@agenciaweb/kit/components/blocks/Text.astro';
import '../styles/index.css';
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe." noindex>
  <Section>
    <div class="row">
      <div class="col-12">
        <Card>
          <Text kind="h1">404 — página no encontrada</Text>
          <Text>Vuelve a la <a href="/">home</a> o escríbenos por WhatsApp.</Text>
        </Card>
      </div>
    </div>
  </Section>
</BaseLayout>
