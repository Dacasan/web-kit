---
import BaseLayout from '@agenciaweb/kit/layouts/BaseLayout.astro';
import Section from '@agenciaweb/kit/components/Section.astro';
import Card from '@agenciaweb/kit/components/blocks/Card.astro';
import Text from '@agenciaweb/kit/components/blocks/Text.astro';
import '../styles/index.css';
---

// noindex deliberado: es una URL de conversión, no de tráfico.
<BaseLayout
  title="[BRAND] Thank you — we received your request"
  description="[BRAND] Your request was received."
  noindex
>
  <Section>
    <div class="col-12">
      <Card>
        <Text level={1} title="[BRAND] Thank you" />
        <Text text="[BRAND] We received your request. We will contact you shortly." />
      </Card>
    </div>
  </Section>
</BaseLayout>
