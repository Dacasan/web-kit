---
import BaseLayout from '@agenciaweb/kit/layouts/BaseLayout.astro';
import Section from '@agenciaweb/kit/components/Section.astro';
import Card from '@agenciaweb/kit/components/blocks/Card.astro';
import Text from '@agenciaweb/kit/components/blocks/Text.astro';
import { site } from '../data/site';
import '../styles/index.css';
---

<BaseLayout title={`Terms — ${site.name}`} description={`Términos y condiciones de ${site.name}.`} noindex>
  <Section>
    <div class="row">
      <div class="col-12">
        <Card>
          <Text level={1} title="Terms &amp; Conditions" />
          <Text>Placeholder terms text: conditions of service for this demo site. Replace every placeholder field before publishing.</Text>
        </Card>
      </div>
    </div>
  </Section>
</BaseLayout>
