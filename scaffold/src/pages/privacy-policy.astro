---
import BaseLayout from '@agenciaweb/kit/layouts/BaseLayout.astro';
import Section from '@agenciaweb/kit/components/Section.astro';
import Card from '@agenciaweb/kit/components/blocks/Card.astro';
import Text from '@agenciaweb/kit/components/blocks/Text.astro';
import { site } from '../data/site';
import '../styles/index.css';
---

<BaseLayout title={`Privacy Policy — ${site.name}`} description={`How ${site.name} handles your data.`} noindex>
  <Section>
    <div class="col-12">
      <Card>
        <Text level={1} title="Privacy Policy" />
        <Text text="Placeholder policy text: how this demo site treats its data. Replace every placeholder field before publishing." />
      </Card>
    </div>
  </Section>
</BaseLayout>
