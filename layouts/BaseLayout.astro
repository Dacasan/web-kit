---
import SeoHead from"../components/SeoHead.astro";
import ContactLauncher from"../components/ContactLauncher.astro";
import Footer from"../components/sections/Footer.astro";
import { CRM_URL } from"../lib/crm-url";
import { site } from"@agenciaweb/kit-site";

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  ogType?: string;
  preloadHero?: { mobile: string; desktop: string; breakpoint: number };
  hasVideo?: boolean;
  noindex?: boolean;
  faq?: readonly { q: string; a: string }[];
  steps?: readonly { title: string; text: string }[];
  breadcrumb?: { name: string; item?: string }[];
  product?: {
    name: string;
    description?: string;
    price?: string;
    ratingValue?: string;
    ratingCount?: string;
  };
}

const {
  title,
  description,
  path ="/",
  ogImage,
  ogType,
  preloadHero,
  hasVideo = false,
  noindex = false,
  faq,
  steps,
  breadcrumb,
  product,
} = Astro.props;

// El cuerpo va antes que <head>: <Image priority> deja el LCP en Astro.locals.
const body = await Astro.slots.render('default');

const { googleAdsConversionId, ga4MeasurementId } = site as {
  googleAdsConversionId?: string;
  ga4MeasurementId?: string;
};

---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    



    {((googleAdsConversionId ?? "") || (ga4MeasurementId ?? "")) && (
      <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    )}
    <link rel="preconnect" href={CRM_URL} crossorigin />
    <link rel="dns-prefetch" href={CRM_URL} />
    <SeoHead
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      preloadHero={Astro.locals.heroImage ?? preloadHero}
      hasVideo={hasVideo}
      faq={faq}
      steps={steps}
      breadcrumb={breadcrumb}
      product={product}
    />
  </head>
  <body>
    
    <main set:html={body} />

    
    <Footer />

    <ContactLauncher />

    


    <script is:inline src={`${CRM_URL}/god.js`}></script>
    <script>
      import"../scripts/wa-ref";
    </script>
  </body>
</html>
