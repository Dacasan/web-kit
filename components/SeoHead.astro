---
import { site } from '@agenciaweb/kit-site';
import { CRM_URL } from"../lib/crm-url";
import { buildGraph } from"../lib/schema";

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  preloadHero?: { mobile: string; desktop: string; breakpoint: number };
  hasVideo?: boolean;
  faq?: readonly { q: string; a: string }[];
  steps?: readonly { title: string; text: string }[];
  breadcrumb?: { name: string; item?: string }[];
  product?: {
    name: string;
    description?: string;
    price?: string;
    ratingValue?: string;
    ratingCount?: string;
  };
}

const {
  title,
  description,
  path ="/",
  ogImage = site.ogImage,
  ogType ="website",
  noindex = false,
  preloadHero,
  hasVideo = false,
  faq,
  steps,
  breadcrumb,
  product,
} = Astro.props;

const canonical = `${site.baseUrl}${path}`;
const robots = noindex || !site.indexable
  ?"noindex, nofollow"
  :"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1";

const { aiDiscovery } = site as { aiDiscovery?: boolean };

const { originTrialToken } = site as { originTrialToken?: string };


const { googleAdsConversionId, metaPixelId, ga4MeasurementId } = site as {
  googleAdsConversionId?: string;
  metaPixelId?: string;
  ga4MeasurementId?: string;
};

const ogFullUrl = ogImage.startsWith("http") ? ogImage : `${site.baseUrl}${ogImage}`;

const graph = buildGraph({
  url: canonical,
  title,
  description,
  faq,
  steps,
  breadcrumb,
  product,
});



---

<title>{title}</title>
{originTrialToken && <meta http-equiv="origin-trial" content={originTrialToken} />}
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
{aiDiscovery && (
  <>
    <link rel="describedby" href="/llms.txt" />
    <link rel="ard" href="/.well-known/ard.json" />
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
  </>
)}
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogFullUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={(site.lang ?? "en-US").replace("-", "_")} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogFullUrl} />












{preloadHero && (
  preloadHero.mobile === preloadHero.desktop ? (
    <link rel="preload" as="image" href={preloadHero.mobile} fetchpriority="high" />
  ) : (
    <>
      <link rel="preload" as="image" href={preloadHero.mobile} media={`(max-width: ${preloadHero.breakpoint - 1}px)`} fetchpriority="high" />
      <link rel="preload" as="image" href={preloadHero.desktop} media={`(min-width: ${preloadHero.breakpoint}px)`} fetchpriority="high" />
    </>
  )
)}

{hasVideo && (
  <>
    <link rel="preconnect" href="https://www.youtube.com" />
    <link rel="preconnect" href="https://www.youtube-nocookie.com" />
  </>
)}

<script type="application/ld+json" is:inline set:html={JSON.stringify(graph)}></script>

<script is:inline define:vars={{ siteUrl: site.baseUrl, apiUrl: CRM_URL }}>
  window.__WACRM_SITE_URL__ = siteUrl;
  window.__WACRM_API_URL__ = apiUrl;
</script>



{googleAdsConversionId && (
  <script is:inline async
    src={`https://www.googletagmanager.com/gtag/js?id=${googleAdsConversionId}`}></script>
)}
{googleAdsConversionId && (
  <script is:inline define:vars={{ gadsId: googleAdsConversionId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', gadsId);
  </script>
)}








{ga4MeasurementId && (
  <script is:inline async
    src={`https://www.googletagmanager.com/gtag/js?id=${ga4MeasurementId}`}></script>
)}
{ga4MeasurementId && (
  <script is:inline define:vars={{ ga4Id: ga4MeasurementId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', ga4Id);
  </script>
)}







{metaPixelId && (
  <script is:inline define:vars={{ fbPixelId: metaPixelId }}>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', fbPixelId);
    fbq('track', 'PageView');
  </script>
)}
{metaPixelId && (
  <noscript>
    <img height="1" width="1" style="display:none"
      src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`} />
  </noscript>
)}
