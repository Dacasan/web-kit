---
// SeoHead — componente SEO centralizado. Todas las páginas comparten este
// <head>: metas, og, canonical, preloads y JSON-LD vía buildGraph.
// Los schemas son siempre iguales (FAQPage, HowTo, BreadcrumbList, Dentist)
// salvo el producto que cambia por página.
import { site } from '@agenciaweb/kit-site';
import { CRM_URL } from"../lib/crm-url";
import { buildGraph } from"../lib/schema";

interface Props {
  title: string;
  description: string;
  /** Ruta relativa con barra final. Default "/". */
  path?: string;
  /** OG image custom. Default site.ogImage. */
  ogImage?: string;
  /** OG type. Default "website". */
  ogType?: string;
  noindex?: boolean;
  preloadHero?: { mobile: string; desktop: string; breakpoint: number };
  hasVideo?: boolean;
  faq?: readonly { q: string; a: string }[];
  steps?: readonly { title: string; text: string }[];
  breadcrumb?: { name: string; item?: string }[];
  /** Producto/tratamiento de la página → nodo con rating + precio. */
  product?: {
    name: string;
    description?: string;
    price?: string;
    ratingValue?: string;
    ratingCount?: string;
  };
}

const {
  title,
  description,
  path ="/",
  ogImage = site.ogImage,
  ogType ="website",
  noindex = false,
  preloadHero,
  hasVideo = false,
  faq,
  steps,
  breadcrumb,
  product,
} = Astro.props;

const canonical = `${site.baseUrl}${path}`;
const robots = noindex || !site.indexable
  ?"noindex, nofollow"
  :"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1";

// Descubrimiento por agentes (opt-in vía site.aiDiscovery): el sitio declara
// en su <head> dónde viven sus ficheros de IA. Sin el flag, cero links —
// demo y scaffold siguen byte a byte iguales y ningún link apunta a un
// archivo 404.
//   - describedby → llms.txt (spec v2, ago-2026: HTML <link> o header Link)
//   - ard → /.well-known/ard.json (spec ARD v0.91: nombre canónico,
//     el consumidor MUST resolverlo) · ai-catalog → path predecesor (lo
//     audita Lighthouse; cortesía para consumidores antiguos)
const { aiDiscovery } = site as { aiDiscovery?: boolean };

// Google tag (gtag.js, AW-…) — opt-in por sitio vía site.googleAdsConversionId.
// Vacío o ausente = el sitio no emite ningún tag de Google (demo, scaffold y
// sitios nuevos nacen apagados). El bucle de conversiones del CRM sigue
// siendo la vía server-side (GOOGLE_ADS_* del entorno); este tag no manda
// eventos de conversión, solo el base tag (dataLayer + cookie de primera
// parte + señales de página para remarketing).

// Cast local: el campo es OPCIONAL a nivel de tipos — un sitio que actualice
// el kit sin declararlo sigue compilando (ausente o vacío = tag no emitido).
const { googleAdsConversionId, metaPixelId } = site as {
  googleAdsConversionId?: string;
  metaPixelId?: string;
};

const ogFullUrl = ogImage.startsWith("http") ? ogImage : `${site.baseUrl}${ogImage}`;

const graph = buildGraph({
  url: canonical,
  title,
  description,
  faq,
  steps,
  breadcrumb,
  product,
});



---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
{aiDiscovery && (
  <>
    <link rel="describedby" href="/llms.txt" />
    <link rel="ard" href="/.well-known/ard.json" />
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
  </>
)}
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogFullUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={(site.lang ?? "en-US").replace("-", "_")} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogFullUrl} />

{/* Precarga de la imagen del hero. Normalmente no la pasa la página: la
    pone <Image priority> desde el cuerpo a través de Astro.locals.

    Los dos `media` son MUTUAMENTE EXCLUYENTES —max-width: BP-1 es el
    complemento exacto de min-width: BP— porque si los dos casaran el
    navegador se descargaría las dos fotos y el preload costaría más de lo
    que ahorra. Ese max-width es aritmética de precarga, no una media query
    de maqueta.

    Con una sola foto para todo va UN link y sin `media`: dos links a la
    misma URL no eligen nada. */}
{preloadHero && (
  preloadHero.mobile === preloadHero.desktop ? (
    <link rel="preload" as="image" href={preloadHero.mobile} fetchpriority="high" />
  ) : (
    <>
      <link rel="preload" as="image" href={preloadHero.mobile} media={`(max-width: ${preloadHero.breakpoint - 1}px)`} fetchpriority="high" />
      <link rel="preload" as="image" href={preloadHero.desktop} media={`(min-width: ${preloadHero.breakpoint}px)`} fetchpriority="high" />
    </>
  )
)}

{hasVideo && (
  <>
    <link rel="preconnect" href="https://www.youtube.com" />
    <link rel="preconnect" href="https://www.youtube-nocookie.com" />
  </>
)}

<script type="application/ld+json" is:inline set:html={JSON.stringify(graph)}></script>

<script is:inline define:vars={{ siteUrl: site.baseUrl, apiUrl: CRM_URL }}>
  window.__WACRM_SITE_URL__ = siteUrl;
  window.__WACRM_API_URL__ = apiUrl;
</script>

{/* Google tag (gtag.js) — señal de página (remarketing y verificación de
    auto-tagging); lo server-side (conversiones) ya lo lleva el CRM. */}
{googleAdsConversionId && (
  <script is:inline async
    src={`https://www.googletagmanager.com/gtag/js?id=${googleAdsConversionId}`}></script>
)}
{googleAdsConversionId && (
  <script is:inline define:vars={{ gadsId: googleAdsConversionId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', gadsId);
  </script>
)}

{/* Meta Pixel (base code oficial, developers.facebook.com/docs/meta-pixel/
    get-started) — opt-in por sitio vía site.metaPixelId. Su papel aquí es
    el lado BROWSER del dedup: planta las cookies _fbp/_fbc que el CRM lee
    y envía PageView con el MISMO event_id que la CAPI usa server-side.
    Sin pixel en el sitio, la CAPI va sola con fbclid sintetizado (EMQ
    bajo); con pixel+CAPI deduplicados, EMQ alto (el setup estándar 2026). */}
{metaPixelId && (
  <script is:inline define:vars={{ fbPixelId: metaPixelId }}>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', fbPixelId);
    fbq('track', 'PageView');
  </script>
)}
{metaPixelId && (
  <noscript>
    <img height="1" width="1" style="display:none"
      src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`} />
  </noscript>
)}
