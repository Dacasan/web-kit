---
interface Props {
  src: string;
  desktop?: string;
  alt?: string;
  width?: number;
  height?: number;
  fit?: 'cover' | 'contain';
  full?: boolean;
  fill?: boolean;
  ratio?: string;
  priority?: boolean;
  rounded?: boolean;
  class?: string;
}

const BP = 900;

const {
  src,
  desktop,
  alt = '',
  width,
  height,
  fit = 'cover',
  full = true,
  fill = false,
  ratio,
  priority = false,
  rounded = true,
  class: cls,
} = Astro.props;

if (!fill && !ratio && (width == null || height == null)) {
  throw new Error(
    `[Image] ${src} necesita \`ratio\` o \`width\`+\`height\`. Sin una de las dos ` +
      'la página salta cuando la imagen entra (CLS), y unas medidas inventadas ' +
      'reservan el hueco equivocado.',
  );
}

const hasDesktop = Boolean(desktop) && desktop !== src;

// Los dos preload son excluyentes: si no, el navegador descarga las dos fotos.
if (priority) {
  Astro.locals.heroImage = {
    mobile: src,
    desktop: hasDesktop ? (desktop as string) : src,
    breakpoint: BP,
  };
}
---

<picture>
  

  {hasDesktop && <source media={`(min-width: ${BP}px)`} srcset={desktop} />}
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    class:list={[
      full && 'is-full-width',
      fill && 'h-100',
      `obj-${fit}`,
      rounded && 'radius-media',
      ratio && 'frame',
      cls,
    ]}
    style={ratio ? `--frame:${ratio}` : undefined}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    decoding={priority ? 'sync' : 'async'}
  />
</picture>
