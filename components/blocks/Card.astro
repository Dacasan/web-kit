---
// Card — el contenedor. Una tarjeta y nada más.
//
// No sabe qué lleva dentro: es un <slot>. Vídeo, texto, estrellas, una
// tabla, lo que sea. Una Card en una columna de 12 es la sección tarjeta.
//
//   <Card><Text …/></Card>
//   <Card><YouTubeLite …/><Text …/></Card>
//   <Card><Stars n={5}/><Text …/></Card>
//   <Card background="/foto.webp" ratio="4/5"><Text …/><a class="button">…</a></Card>
//   <Card featured ribbon="Más elegido"><Text …/></Card>
//
// El radio, el filete y la sombra vienen de .card. Todo lo demás está aquí
// abajo, en el <style> con scope: no añade ni una clase al CSS global.
import Image from './Image.astro';

interface Props {
  /** Proporción:"1" ·"4/5" ·"9/16" ·"16/9". Sin ella la altura la pone
      el contenido, que es lo normal en una tarjeta de texto. */
  ratio?: string;
  /**
   * Lo que va detrás del contenido. Una sola prop porque es una sola
   * decisión y solo puede haber una cosa al fondo:
   *   una ruta          → foto       background="/gallery/foto.webp"
   *   primary · accent
   *   dark · soft       → sólido     background="dark"
   *
   * Solo esos cuatro nombres: son los fondos que ya tiene el sistema. Un
   * hex suelto aquí es cómo una página acaba con un turquesa que no es EL
   * turquesa.
   */
  background?: string;
  /** Variante de escritorio, si el fondo es foto. */
  backgroundDesktop?: string;
  alt?: string;
  /** La foto de esta tarjeta es el LCP. Una por página. */
  priority?: boolean;
  /** Destacada: el filete pasa a color de marca. */
  featured?: boolean;
  /** Cinta que cabalga el borde superior. */
  ribbon?: string;
  /** Toda la superficie pulsable. Dentro no puede ir otro <a>. */
  href?: string;
  itemtype?: string;
  class?: string;
}

const {
  ratio,
  background,
  backgroundDesktop,
  alt = '',
  priority = false,
  featured = false,
  ribbon,
  href,
  itemtype,
  class: cls,
} = Astro.props;

// Los cuatro fondos del sistema. El contraste de cada uno está medido en
// 02-tokens.css y por eso no se elige el vistoso para todo:
//   --brand-accent-deep  blanco encima: exige >=4.5:1 — AA texto corrido
//   --brand-primary-on-dark       blanco encima suele quedar <4.5:1 — SOLO titulares grandes
//   --brand-ink          blanco encima: el par de mayor contraste del sistema
//   --brand-tint         es CLARO: la tinta va oscura, no blanca
const BG = {
  primary: 'var(--cta-bg)',
  accent: 'var(--primary)',
  dark: 'var(--bg-dark)',
  soft: 'var(--bg-soft)',
} as const;

// Foto o color, por la forma del valor.
const isPhoto = Boolean(background) && /^(\/|https?:|data:)/.test(background as string);
const token = !isPhoto && background ? BG[background as keyof typeof BG] : undefined;

// Sin defaults silenciosos: un nombre que no existe rompe el build en vez de
// dejar la tarjeta con el fondo oscuro por defecto y que nadie se entere.
if (background && !isPhoto && !token) {
  throw new Error(
    `[Card] background="${background}" no existe. Usa una ruta de imagen o uno de: ` +
      `${Object.keys(BG).join(' · ')}.`,
  );
}

const hasBg = isPhoto || Boolean(token);
// `soft` es un fondo claro: encima la tinta va oscura. Los otros tres y las
// fotos llevan velo o son oscuros, así que la tinta va clara.
const darkInk = background === 'soft';

const vars =
  [ratio && `--ratio:${ratio}`, token && `--bg:${token}`].filter(Boolean).join(';') || undefined;

const Tag = href ? 'a' : 'div';
---

<Tag
  class:list={['card', hasBg && 'bg', isPhoto && 'photo', darkInk && 'ink-dark', ratio && 'ratio', featured && 'featured', ribbon && 'ribboned', href && 'link', cls]}
  href={href}
  style={vars}
  itemscope={itemtype ? true : undefined}
  itemtype={itemtype}
>
  {isPhoto && <Image src={background as string} desktop={backgroundDesktop} alt={alt} priority={priority} fill rounded={false} />}
  {ribbon && <span class="ribbon">{ribbon}</span>}
  {hasBg ? <div class="content"><slot /></div> : <slot />}
</Tag>

<style>
  /* Alturas iguales en una fila: sin esto, tres tarjetas con distinto texto
     quedan a tres alturas.
     :not(.ratio) NO es un detalle. Con `height: 100%` la tarjeta tiene altura
     definida, y entonces aspect-ratio deduce el ANCHO a partir del alto: una
     tarjeta 16/9 en una columna de 296px se pone a 936px de ancho y saca la
     página por la derecha. Con ratio manda la proporción y la altura sale
     sola. */
  .card:not(.ratio) { height: 100%; }

  /* La proporción manda sobre el alto; el techo evita que un 9/16 a ancho
     completo se coma la pantalla entera en un móvil. */
  .ratio { aspect-ratio: var(--ratio, 1); max-height: var(--v-block); }

  /* Titular DENTRO de una tarjeta. La escala de h3 de la capa base (2.8rem,
     Fraunces 300/400) es de encabezado de documento: dentro de una tarjeta
     compite con el h2 de la sección y hace que la tarjeta se lea como otra
     sección. 2.4rem con peso 600 es lo que hacía .card__title antes.
     :global porque el titular viene del slot y no lleva el scope de aquí. */
  .card :global(:is(h2, h3, h4)) {
    font-size: var(--text-xl);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -.01em;
    margin: 0 0 .8rem;
  }
  /* Y el párrafo que le sigue, con aire suficiente para no pegarse. */
  .card :global(p) { margin-block: 0 .8rem; }
  .card :global(> :last-child) { margin-bottom: 0; }

  .featured { border-color: var(--primary); }

  /* display:block NO es cosmético. Un <a> es inline por defecto, así que una
     tarjeta-enlace con un <h3> y un <p> dentro se rompe: la caja se queda en
     una astilla y el contenido se sale por los lados. */
  .link {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: border-color .15s ease;
  }
  /* La capa base baja al 75% cualquier <a> con el cursor encima, y sobre una
     tarjeta entera eso la lava en vez de destacarla. */
  .link:hover { opacity: 1; border-color: var(--primary); }

  /* ── Con fondo propio ──
     Una rejilla de UNA celda: todos los hijos caen en la misma y se apilan
     solos. Sin position:absolute, sin z-index, sin contexto de apilamiento
     que luego pelee con la cinta. */
  .bg {
    display: grid;
    grid-template-areas: 'stack';
    padding: 0;
    overflow: hidden;
    border: 0;
    background: var(--bg, var(--bg-dark));
    color: var(--ink-body-on-dark);
  }
  /* :global porque lo que viene del slot —y la <Image>— no lleva el scope
     de este componente: lo pone quien lo escribe, no la tarjeta. */
  .bg > :global(*) { grid-area: stack; }
  .bg :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .bg :global(:is(h1, h2, h3)) { color: var(--ink-title-on-dark); }
  /* .text-body fija tinta oscura, así que sobre el velo el texto salía negro.
     `inherit` se lo devuelve a la tarjeta en vez de pelearse con otro fijo. */
  .bg :global(:is(p, li, .text-body, .lead)) { color: inherit; }

  /* Fondo claro (soft): la tinta vuelve a ser la del cuerpo. Va después de
     las reglas de arriba para ganarles por orden, sin subir especificidad. */
  .ink-dark { color: var(--ink-body); }
  .ink-dark :global(:is(h1, h2, h3)) { color: var(--ink-body); }

  /* Velo de legibilidad SOLO sobre foto: sobre color plano no añade nada y
     lo ensucia. Sólido al 60% — la guía de marca prohíbe degradados. */
  .photo::after {
    content: '';
    grid-area: stack;
    background: var(--veil-solid);
  }

  /* El contenido va abajo, que es donde se lee una tarjeta con foto, y trae
     su relleno porque .bg no lo tiene. `relative` lo pone sobre el velo. */
  .content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: .8rem;
    padding: 2.4rem;
    min-width: 0;
  }

  /* La cinta sale medio cuerpo por encima del borde, así que la tarjeta
     tiene que darle de qué colgarse y no recortarla. */
  .ribboned { position: relative; overflow: visible; }
  .ribbon {
    position: absolute;
    top: -1.2rem;
    left: 50%;
    transform: translateX(-50%);
    padding: .4rem 1.2rem;
    white-space: nowrap;
    font-size: var(--text-xs);
    letter-spacing: .1em;
    text-transform: uppercase;
    background: var(--primary);
    color: var(--ink-on-primary);
    border-radius: var(--radius);
  }
</style>
