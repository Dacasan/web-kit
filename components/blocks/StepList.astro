---
interface Props {
  marker?: 'bullet' | 'numbered';
  class?: string;
}

const { marker = 'bullet', class: cls } = Astro.props;
const Tag = marker === 'numbered' ? 'ol' : 'ul';
---

<Tag class:list={['step-list', `mk-${marker}`, cls]}>
  <slot />
</Tag>

<style>
  
  .mk-numbered { counter-reset: paso; }

  .mk-bullet :global(li)::before,
  .mk-numbered :global(li)::before {
    flex-shrink: 0;
    color: var(--ink-primary);
  }

  

  .mk-bullet :global(li)::before {
    content: '·';
    display: grid;
    place-items: center;
    width: 32px;
    font-size: var(--text-xl);
    line-height: 1;
  }

  
  .mk-numbered :global(li)::before {
    counter-increment: paso;
    content: counter(paso);
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    font-size: var(--text-xs);
    font-weight: 700;
    border: 1px solid var(--ink-primary);
    border-radius: 50%;
  }
</style>
