---
// HeroLede — la columna de texto del hero.
//
// JERARQUÍA REAL: el titular grande es el <h1> (o <h2> donde la página ya
// tiene uno) y la chapita de disponibilidad es un <p>. Antes era al revés
// —chapita de 11 px como h1, claim de 80 px como p— y el documento abría
// con un encabezado que nadie lee como encabezado. La keyword sigue en el
// <title>, en el primer h2 y en el copy; no depende de un h1 de 11 px.
//
// Va dentro de una <Section pad="hero">. No trae fondo ni ancho propios.
import { site, PRIMARY_CTA, whatsappHref } from '@agenciaweb/kit-site';

interface Props {
  /** La chapita de disponibilidad. Es un <p>, no un encabezado. */
  badge?: string;
  /** Nivel del titular. 1 en una landing; 2 en un catálogo, donde el h1
      ya lo pone la página y no puede haber dos. */
  level?: 1 | 2;
  /** El titular visible, grande. Admite <em> dorado. */
  displayTitle?: string;
  subtitle?: string;
  /** Texto del CTA principal. */
  cta?: string;
  ctaHref?: string;
  /** Texto del botón de WhatsApp. Vacío para no pintarlo. */
  waText?: string;
  /** Cifras bajo los botones. Por defecto, las dos primeras de site.proof. */
  stats?: { num: string; label: string }[];
}

const {
  badge = 'Now booking new projects',
  level = 1,
  displayTitle = 'A clear offer, in one line.',
  subtitle = 'One sentence on what you do, for whom, and what happens next.',
  cta = PRIMARY_CTA,
  ctaHref = '#consulta',
  waText = 'WhatsApp',
  stats = site.proof.slice(0, 2),
} = Astro.props;

const Heading = `h${level}` as 'h1' | 'h2';
---

<div class="hero-lede">
  <p class="hero-avail-badge">
    <span class="hero-avail-badge__dot" aria-hidden="true"></span>
    {badge}
  </p>

  <Heading class="hero-title" itemprop="headline" set:html={displayTitle} />
  {subtitle && <p class="lead hero-sub">{subtitle}</p>}

  <div class="btn-row">
    {/* .accent y no .primary: este es EL CTA de la página, no una repetición. */}
    <a href={ctaHref} class="button accent pill">{cta}</a>
    {waText && (
      <a href={whatsappHref} class="button outline pill" target="_blank" rel="noopener" data-wa-cta>
        {waText}
      </a>
    )}
  </div>

  {stats.length > 0 && (
    <ul class="inline-stats hero-stats">
      {stats.map((p) => (
        <li class="inline-stat">
          <strong class="inline-stat__num text-primary">{p.num}</strong>
          <span class="inline-stat__label">{p.label}</span>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  /* .btn-row global centra; en el hero los botones van a la izquierda,
     alineados con el titular. */
  .btn-row { justify-content: flex-start; }
  /* La capa base le da al h1 letter-spacing y margen de titular; el
     .hero-title global ya los normaliza. La chapita es un párrafo: el
     margen lo pone .hero-avail-badge. */
  :is(h1, h2).hero-title { margin: 0; }
  .hero-sub { margin: 1.6rem 0 2.4rem; }
  .hero-stats { margin-top: 2.4rem; }
</style>
