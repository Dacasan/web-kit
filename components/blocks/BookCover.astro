---
interface Props {
  cover?: string;
  title?: string;
}

const {
  cover = '/guide-cover.svg',
  title = 'Guide',
} = Astro.props;
---

<figure class="book-stage">
  
  <span class="book__shadow" aria-hidden="true"></span>

  <div class="book">
    <div class="book__face">
      <img src={cover} alt={`Cover of ${title}`} width="280" height="373" loading="lazy" decoding="async" />
      <span class="book__binding" aria-hidden="true"></span>
      <span class="book__sheen" aria-hidden="true"></span>
    </div>
    <span class="book__edge" aria-hidden="true"></span>
  </div>
</figure>

<style>
  


  .book-stage {
    position: relative;
    display: grid;
    place-items: center;
    margin: 0;
    padding-block: 4.8rem;
    perspective: 1600px;
    perspective-origin: 50% 40%;
  }

  
  .book {
    --book-w: min(280px, 62vw);
    --book-depth: 26px;

    position: relative;
    width: var(--book-w);
    aspect-ratio: 3 / 4;
    transform-style: preserve-3d;
    will-change: transform, translate;

    



    transform: rotateX(6deg) rotateY(-22deg);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);

    

    animation:
      book-float 7s ease-in-out infinite,
      book-tilt 11s ease-in-out infinite;
  }

  



  .book__face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 6px 14px 14px 6px; 
    box-shadow:
      0 2px 6px rgb(16 24 40 / 0.18),
      0 24px 48px rgb(16 24 40 / 0.22);
  }
  .book__face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  
  .book__binding {
    position: absolute;
    inset: 0 auto 0 0;
    width: 13%;
    background: linear-gradient(
      90deg,
      rgb(0 0 0 / 0.38) 0,
      rgb(0 0 0 / 0.1) 42%,
      rgb(255 255 255 / 0.16) 72%,
      rgb(0 0 0 / 0.06) 100%
    );
  }

  


  .book__edge {
    position: absolute;
    top: 1.2%;
    right: 0;
    width: var(--book-depth);
    height: 97.6%;
    transform-origin: right center;
    transform: rotateY(-90deg);
    background: repeating-linear-gradient(90deg, #f4f4f0 0 1px, #d9d9d2 1px 2.5px);
    border-radius: 0 6px 6px 0;
  }

  



  .book__sheen {
    position: absolute;
    top: -20%;
    left: 0;
    width: 35%;
    height: 140%;
    mix-blend-mode: screen;
    filter: blur(2px);
    rotate: 12deg;
    background: linear-gradient(
      100deg,
      #0000,
      #ffffff14 35%,
      #ffffff8c 50%,
      #ffffff14 65%,
      #0000
    );
    animation: book-sheen 5s linear infinite;
  }

  




  .book__shadow {
    position: absolute;
    left: 15%;
    bottom: 2.4rem;
    width: 70%;
    height: 20px;
    background: radial-gradient(ellipse at center, rgb(16 24 40 / 0.34), #0000 70%);
    filter: blur(10px);
    animation: book-shadow 7s ease-in-out infinite;
  }

  @keyframes book-float {
    0%,
    100% {
      translate: 0 -7px;
    }
    50% {
      translate: 0 7px;
    }
  }
  @keyframes book-tilt {
    0%,
    100% {
      rotate: y 0deg;
    }
    50% {
      rotate: y 3deg;
    }
  }
  @keyframes book-sheen {
    0% {
      translate: -180% 0;
    }
    55%,
    100% {
      translate: 420% 0;
    }
  }
  @keyframes book-shadow {
    0%,
    100% {
      scale: 0.9;
      opacity: 0.45;
    }
    50% {
      scale: 1.06;
      opacity: 0.8;
    }
  }

  
  @media (hover: hover) {
    .book-stage:hover .book {
      transform: rotateX(2deg) rotateY(-7deg) scale(1.03);
    }
  }

  


  @media (prefers-reduced-motion: reduce) {
    .book,
    .book__sheen,
    .book__shadow {
      animation: none;
    }
    .book {
      transform: rotateY(-10deg);
      transition: none;
    }
    .book__sheen {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .book {
      --book-w: 280px;
    }
    .book-stage {
      padding-block: 6.4rem;
    }
  }
</style>
