---
// ContactFields — los campos de datos, SIN el <form> alrededor.
//
// Existe por una razón concreta: el estimado necesita que su cuestionario y
// los datos de contacto viajen en el MISMO <form> (un solo envío, un solo
// lead), y un <form> no se puede anidar dentro de otro. Si este bloque
// viviera dentro de ContactForm.astro, el estimado tendría que copiarlo —
// y una copia es cómo dos formularios acaban divergiendo sin que nadie lo
// note: obligatoriedad distinta, consentimiento en uno sí y en otro no,
// nombres de campo que bailan.
//
// Aquí está el contrato con el CRM: los `name` de los campos, el campo
// trampa y los ocultos de atribución que rellena god.js. Quien monte esto
// dentro de un <form data-lead-form> hereda el comportamiento completo.
import { TREATMENT_OPTIONS, site } from '@agenciaweb/kit-site';

interface SelectOption { value: string; label: string }

/**
 * Campos extra por cliente — opt-in vía site.ts (site.leadExtraFields).
 * Un sitio que no los declara no renderiza NADA: allon4, demo y scaffold
 * quedan byte a byte iguales (mismo patrón de cast defensivo que los campos
 * de medición, SeoHead v1.2.8). Los `name` viajan a lead-form.ts, que los
 * adjunta al `message` del lead con su etiqueta — el CRM los lee como texto
 * libre sin cambios de esquema.
 */
interface LeadExtraField {
  /** Solo tipos nativos de HTML: `date` es el calendario del móvil, sin librerías. */
  type: 'date' | 'select' | 'number' | 'text';
  name: string;
  label: string;
  required?: boolean;
  options?: SelectOption[];
}

interface Props {
  /** Sufijo de los id: dos formularios en el mismo documento no colisionan. */
  formId: string;
  selectLabel?: string;
  selectOptions?: SelectOption[];
  /** Texto de la casilla de consentimiento. */
  consentText?: string;
}


// Textos del formulario por sitio — opt-in vía site.formLabels. Un sitio
// que no los declara conserva los textos por defecto (inglés) byte a byte.
interface FormLabels {
  name?: string; email?: string; phone?: string; selectLabel?: string;
  namePh?: string; emailPh?: string; phonePh?: string; phonePrefix?: string;
  consentLinks?: string;
}
const FL = (site as { formLabels?: Partial<FormLabels> }).formLabels ?? {};

const {
  formId,
  selectLabel = FL.selectLabel ?? "Treatment",
  selectOptions = TREATMENT_OPTIONS,
  // Lenguaje de consentimiento exigido por la verificación A2P 10DLC de
  // Twilio: consentimiento explícito, frecuencia variable, tarifas y
  // opt-out STOP. Los enlaces a /privacy-policy/ y /terms/ se añaden
  // debajo — ambas páginas existen y están enlazadas en el footer.
  //
  // La redacción vive en el site.ts del CLIENTE (smsConsentText, con {name})
  // — el kit no lleva datos de negocio. {name} se sustituye aquí por el
  // nombre real de la cuenta.
  consentText,
} = Astro.props;

const consent = (consentText ?? site.smsConsentText).replace("{name}", site.name);



// Cast defensivo: el campo es OPCIONAL a nivel de tipos — un sitio viejo que
// actualice el kit sigue compilando (ausente = cero campos extra).
const { leadExtraFields: extraFields } = site as {
  leadExtraFields?: readonly LeadExtraField[];
};

const id = (name: string) => `${formId}-${name}`;
---

<p class="form__error" id={id("error")} role="alert" tabindex="-1" hidden></p>

<div class="field">
  <label class="form-label" for={id("name")}>{FL.name ?? "Name"} *</label>
  <input
    id={id("name")}
    name="name"
    type="text"
    autocomplete="name"
    maxlength="80"
    required
    placeholder={FL.namePh ?? "Alex Rivera"}
    toolparamdescription="Patient's full name"
  />
</div>

<div class="field">
  <label class="form-label" for={id("email")}>{FL.email ?? "Email"} *</label>
  <input
    id={id("email")}
    name="email"
    type="email"
    autocomplete="email"
    inputmode="email"
    maxlength="120"
    required
    placeholder={FL.emailPh ?? "alex@email.com"}
    toolparamdescription="Contact email address"
  />
</div>

<div class="field">
  <label class="form-label" for={id("phone")}>{FL.phone ?? "Phone"} *</label>
  <div class="form-prefix">
    <span class="badge form-prefix__sign" aria-hidden="true">{FL.phonePrefix ?? "+1"}</span>
    <input
      id={id("phone")}
      name="phone"
      type="tel"
      autocomplete="tel"
      inputmode="tel"
      maxlength="24"
      required
      placeholder={FL.phonePh ?? "(555) 000-0000"}
      toolparamdescription="Phone number including country code"
    />
  </div>
</div>

<div class="field">
  <label class="form-label" for={id("package")}>{selectLabel}</label>
  <select id={id("package")} name="package" toolparamdescription="Treatment the patient is interested in">
    {selectOptions.map((o) => <option value={o.value}>{o.label}</option>)}
  </select>
</div>

{/* Campos extra del cliente (opt-in vía site.ts). Tras el desplegable de
    destino y antes del consentimiento: el orden de lectura es el mismo para
    todos los formularios del sitio porque los pinta este único bloque. */}
{extraFields?.map((f) => (
  <div class="field">
    <label class="form-label" for={id(f.name)}>{f.label}{f.required && " *"}</label>
    {f.type === "select" ? (
      <select id={id(f.name)} name={f.name} required={f.required}>
        {(f.options ?? []).map((o) => <option value={o.value}>{o.label}</option>)}
      </select>
    ) : (
      <input id={id(f.name)} name={f.name} type={f.type} required={f.required} />
    )}
  </div>
))}

<label class="form-consent" for={id("consent")}>
  <input id={id("consent")} name="consent" type="checkbox" required toolparamdescription="Confirms the patient agrees to be contacted about their case" />
  <span>
    {consent}
    {FL.consentLinks
      ? <Fragment set:html={(FL as { consentLinks?: string }).consentLinks} />
      : <>See our <a href="/privacy-policy/">Privacy Policy</a> and <a href="/terms/">Terms</a>.</>}
  </span>
</label>

{/* Campo trampa: oculto y fuera del orden de tabulación (skill §20). */}
<div class="form__trap" aria-hidden="true">
  <label for={id("company_website")}>Do not fill</label>
  <input id={id("company_website")} name="company_website" type="text" tabindex="-1" autocomplete="off" />
</div>

{/* Campos ocultos que rellena god.js antes del envío. */}
<input type="hidden" name="utm_source" />
<input type="hidden" name="utm_medium" />
<input type="hidden" name="utm_campaign" />
<input type="hidden" name="utm_term" />
<input type="hidden" name="utm_content" />
<input type="hidden" name="gclid" />
<input type="hidden" name="gbraid" />
<input type="hidden" name="wbraid" />
<input type="hidden" name="fbclid" />
<input type="hidden" name="msclkid" />
<input type="hidden" name="ttclid" />
<input type="hidden" name="li_fat_id" />
<input type="hidden" name="gad_source" />
<!-- Google Ads ad-level (tracking template a nivel de cuenta). Prefijo
     `gads_` a propósito: un name genérico como `location` podría chocar con
     un campo visible futuro del formulario, y fillHiddenInputs sobrescribe
     en silencio. Los declara god.ts en el contrato; lead-form.ts los lee. -->
<input type="hidden" name="gads_matchtype" />
<input type="hidden" name="gads_campaign_id" />
<input type="hidden" name="gads_ad_group_id" />
<input type="hidden" name="gads_ad_id" />
<input type="hidden" name="gads_location" />
<input type="hidden" name="landing_slug" />
<input type="hidden" name="ref_code" />
<input type="hidden" name="event_id" />
<input type="hidden" name="channel" />
<input type="hidden" name="medium" />
<input type="hidden" name="visitor_id" />
{/* Señal Meta: fbc/fbp los planta god.js desde cookies _fbc/_fbp (hoy
    vacíos — no hay píxel, DEF-6) y referrer desde document.referrer. El
    servidor sintetiza fbc desde fbclid cuando la cookie no existe. */}
<input type="hidden" name="fbc" />
<input type="hidden" name="fbp" />
<input type="hidden" name="referrer" />

<script>
  // Carga DIFERIDA de lead-form — traza móvil (Slow 4G, CPU 4×): el chunk
  // ContactFields → lead-form.B5LQxeU7.js costaba 854 ms en la cadena
  // crítica aunque nadie tocara el form. El import estático de arriba lo
  // metía en la carga inicial; aquí se trae solo cuando hace falta.
  //
  // lead-form.ts se auto-inicializa al evaluarse (wires todos los
  // [data-lead-form]), así que basta con importarlo. Disparadores:
  //   1. cualquier interacción DENTRO de un form (pointerdown/focusin/keydown)
  //   2. red de seguridad: el propio submit — sin ella, un Enter rápido
  //      dispararía el envío nativo del <form> (novalidate, sin action):
  //      GET con la PII en la URL. El listener es capture en window, así
  //      que corre ANTES que el handler de lead-form y puede cancelarlo.
  let pending: Promise<void> | null = null;
  let ready = false;
  const load = (): Promise<void> =>
    (pending ??= import("../scripts/lead-form").then(() => { ready = true; }));

  const isLead = (t: EventTarget | null): boolean =>
    t instanceof Element && t.closest("[data-lead-form]") !== null;

  const interact = (e: Event): void => {
    if (!isLead(e.target)) return;
    window.removeEventListener("pointerdown", interact, true);
    window.removeEventListener("focusin", interact, true);
    window.removeEventListener("keydown", interact, true);
    void load();
  };
  window.addEventListener("pointerdown", interact, true);
  window.addEventListener("focusin", interact, true);
  window.addEventListener("keydown", interact, true);

  window.addEventListener("submit", (e) => {
    const form = e.target;
    if (!(form instanceof HTMLFormElement)) return;
    if (!form.matches("[data-lead-form]")) return;
    if (ready) return; // el módulo ya wired: su propio listener se ocupa
    e.preventDefault();
    void load().then(() => form.requestSubmit());
  }, true);
</script>
