---
import { site } from '@agenciaweb/kit-site';

interface Props {
  id?: string;
  desktopId?: string;
  ratio?: 'auto' | 'vertical' | 'horizontal';
  playlabel?: string;
  thumbMobile?: string;
  thumbDesktop?: string;
}

const {
  id = site.videoId,
  desktopId,
  ratio = 'auto',
  playlabel = 'Watch video',
  thumbMobile,
  thumbDesktop,
} = Astro.props;

const ytThumb = (v: string) => `https://i.ytimg.com/vi/${v}/hqdefault.jpg`;
const mobileThumb = thumbMobile ?? ytThumb(id);
const desktopThumb = thumbDesktop ?? ytThumb(desktopId ?? id);

interface VideoMeta {
  name: string;
  description?: string;
  uploadDate: string;
  duration?: string;
}
const registry = (site as { videos?: Record<string, VideoMeta> }).videos;
const videoMeta = registry?.[id];
const embedUrl = `https://www.youtube-nocookie.com/embed/${id}`;
const contentUrl = `https://www.youtube-nocookie.com/embed/${id}`;
---

<div
  class:list={[
    'youtube-video',
    'frame', 'frame--exact',
    ratio === 'vertical' && 'ratio-vertical',
    ratio === 'horizontal' && 'ratio-horizontal',
  ]}
  data-video-id={id}
  data-desktop-video-id={desktopId}
>
  

  <picture>
    {desktopThumb !== mobileThumb && (
      <source media="(min-width: 900px)" srcset={desktopThumb} width="960" height="540" />
    )}
    <img src={mobileThumb} width="1080" height="1920" alt={playlabel} loading="lazy" decoding="async" />
  </picture>
  


  <button type="button" class="play-button" aria-label={playlabel}
          data-track="video_play" data-track-label={id}>
    <svg viewBox="0 0 24 24" width="68" height="48">
      <path
        fill="#f00"
        d="M23.5 6.2c-.3-1.1-1.2-2-2.3-2.3C19.3 3.5 12 3.5 12 3.5s-7.3 0-9.2.4c-1.1.3-2 1.2-2.3 2.3C.1 8.1.1 12 .1 12s0 3.9.4 5.8c.3 1.1 1.2 2 2.3 2.3 1.9.4 9.2.4 9.2.4s7.3 0 9.2-.4c1.1-.3 2-1.2 2.3-2.3.4-1.9.4-5.8.4-5.8s0-3.9-.4-5.8z"
      ></path>
      <path fill="#fff" d="M9.8 15.5v-7l6.5 3.5-6.5 3.5z"></path>
    </svg>
  </button>
  <div class="youtube-iframe"></div>
</div>



{videoMeta && (
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "VideoObject",
      name: videoMeta.name,
      ...(videoMeta.description ? { description: videoMeta.description } : {}),
      // thumbnailUrl absoluta o Google no indexa el vídeo.
      thumbnailUrl: [mobileThumb, desktopThumb].map((t) =>
        t.startsWith("http") ? t : `${site.baseUrl}${t}`,
      ),
      uploadDate: videoMeta.uploadDate,
      ...(videoMeta.duration ? { duration: videoMeta.duration } : {}),
      embedUrl,
      contentUrl,
      creator: { "@type": "Organization", name: site.name, url: site.baseUrl },
    })}
  />
)}




<style>
  .play-button {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(0 0 0 / 0.3);
    transition: background 0.2s ease;
    z-index: 2;
  }
  .youtube-video:hover .play-button {
    background: rgb(0 0 0 / 0.5);
  }
  .play-button svg {
    filter: drop-shadow(0 2px 4px rgb(0 0 0 / 0.5));
    transition: transform 0.2s ease;
  }
  .youtube-video:hover .play-button svg {
    transform: scale(1.05);
  }
  @media (prefers-reduced-motion: reduce) {
    .play-button,
    .play-button svg {
      transition: none;
    }
  }
</style>
