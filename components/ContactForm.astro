---
import ContactFields from"./ContactFields.astro";
import { site } from "@agenciaweb/kit-site";

interface SelectOption { value: string; label: string }

interface Props {
  formId: string;
  heading?: string;
  sub?: string;
  cta?: string;
  selectLabel?: string;
  selectOptions?: SelectOption[];
  thankYou?: string;
}

const {
  formId,
  heading,
  sub,
  cta ="Get My Quote",
  selectLabel,
  selectOptions,
  thankYou ="/thank-you",
} = Astro.props;

const isGuide = thankYou === "/thank-you-download";
const toolname = isGuide ? "download_guide" : "request_quote";
const tooldescription = isGuide
  ? "Sends the contact's name, email and phone so the business can send them the promised resource."
  : "Sends a contact request to the business. The team replies within 24 hours with the next steps.";
---

<form
  id={`lead-form-${formId}`}
  class="form"
  data-lead-form
  data-thank-you={thankYou}
  toolname={toolname}
  tooldescription={tooldescription}
  novalidate
>
  {heading && <h3 class="form-heading">{heading}</h3>}
  {sub && <p class="form-sub">{sub}</p>}

  <ContactFields formId={formId} selectLabel={selectLabel} selectOptions={selectOptions} />

  <button type="submit" class="button primary">{cta}</button>
  <p class="form__trust">{(site as { formLabels?: { trust?: string } }).formLabels?.trust ?? "No commitment. We reply within 24 hours."}</p>
</form>

<style>
  
  .form-heading {
    font-size: var(--text-xl);
    line-height: 1.3;
    font-weight: 600;
    margin: .35em 0 1.6rem;
  }
  .form-sub {
    font-size: var(--text-sm);
    margin: 0 0 1.6rem;
  }
  .form__trust { font-size: var(--text-xs); }
</style>
