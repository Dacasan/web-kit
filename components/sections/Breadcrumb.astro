---
interface Crumb { name: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
---

<nav class="crumbs container" aria-label="Breadcrumb">
  <ol role="list">
    {items.map((c, i) => (
      <li>
        {c.href && i < items.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs { padding-block: 1.2rem; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: 0; padding: 0; font-size: var(--text-xs); color: var(--ink-muted); }
  .crumbs li + li::before { content: '›'; margin-right: .5rem; }
  

  .crumbs a { color: var(--ink-muted); text-decoration: underline; }
  .crumbs a, .crumbs span { display: inline-block; padding-block: .4rem; }
</style>
