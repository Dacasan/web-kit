---
import ContactForm from '../ContactForm.astro';
import { site, PRIMARY_CTA, MENU_LINKS, TOPBAR, whatsappHref } from '@agenciaweb/kit-site';

interface Props {
  variant?: 'money' | 'seo';
  links?: { href: string; text: string }[];
  cta?: string;
  ratingText?: string;
  ratingHeadline?: string;
  rating?: { value?: string; count?: string };
  topbar?: string[];
}

const {
  variant = 'seo',
  cta = PRIMARY_CTA,
  ratingText = `${site.rating.value}/5 from ${Number(String(site.rating.count).replace(/,/g, "")).toLocaleString("en-US")} reviews`,
  ratingHeadline = (site as { ratingHeadline?: string }).ratingHeadline ?? "TOP RATED team",
  rating: ratingOpt, // override de página opcional
} = Astro.props;

const rating = ratingOpt ?? site.rating;
const ratingHasValue = Boolean(String(rating?.value ?? '').trim());

const links = Astro.props.links ?? (variant === 'money' ? [] : MENU_LINKS);
const topbar = Astro.props.topbar ?? (variant === 'money' ? TOPBAR : undefined);
---

{topbar && topbar.length > 0 && (
  <div class="topbar">
    <div class="container topbar__inner">
      {topbar.map((t) => <span>{t}</span>)}
    </div>
  </div>
)}

<header class="nav">
  <div class="container nav__inner">
    





    <a href="/" class="nav__brand">
      <img
        src={site.logoDark ?? site.logo}
        alt={site.name}
        width="520"
        height="147"
        decoding="sync"
      />
    </a>

    {links.length > 0 && (
      <>
        <input type="checkbox" id="nav-toggle" class="nav-toggle" role="button"
          aria-label="Open menu" aria-expanded="false" aria-controls="site-menu" />
        <label for="nav-toggle" class="nav-toggle-label" aria-hidden="true"><span></span></label>

        <nav class="nav-center" id="site-menu" aria-label="Main">
          <ul>
            {links.map((l) => <li><a href={l.href}>{l.text}</a></li>)}
          </ul>
        </nav>
      </>
    )}

    
    

    {ratingHasValue && (
    <div class="nav-rating" role="group" aria-label={`${ratingHeadline}, ${ratingText}`}>
      <span class="nav-rating__stars" aria-hidden="true">★★★★★</span>
      <span class="nav-rating__text">
        <strong>{ratingHeadline}</strong>
        <span>{ratingText}</span>
      </span>
    </div>
    )}
    

    <a href="#form-popup" class="button primary nav__cta">{cta}</a>
  </div>
</header>


<div class="lightbox" id="form-popup" role="dialog" aria-modal="true" aria-labelledby="form-popup-title">
  <a href="#!" class="lightbox-close" aria-label="Close">&times;</a>
  <div class="lightbox__panel">
    


    <p class="popup-title" id="form-popup-title">{cta}</p>
    <p class="popup-sub">{(site as { formLabels?: { popupSub?: string } }).formLabels?.popupSub ?? "We'll contact you by WhatsApp within 24 hours."}</p>
    <ContactForm formId="popup" cta={cta} />
    <p class="popup-note text-center">
      <a href={whatsappHref} target="_blank" rel="noopener" data-wa-cta>{(site as { formLabels?: { waNote?: string } }).formLabels?.waNote ?? "or message us on WhatsApp"}</a>
    </p>
  </div>
</div>

<style>
  




  .topbar {
    background: var(--bg-dark);
    color: var(--ink-body-on-dark);
    border-bottom: 1px solid rgb(255 255 255 / .14);
    font-size: 1.3rem;
    padding-block: .6rem;
  }
  .topbar__inner {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: .8rem 2rem;
  }
  
  .topbar__inner > span:last-child {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
  }
  .topbar__inner > span:last-child::before {
    content: '';
    width: 10px; height: 10px;
    border-radius: 50%;
    background: var(--color-whatsapp);
    box-shadow: 0 0 0 2px var(--ink-body-on-dark);
    flex-shrink: 0;
    animation: lx-pulse 2.4s ease-in-out infinite;
  }

  

  .nav {
    position: sticky; top: 0; z-index: var(--z-nav);
    background: var(--bg-dark);
    border-bottom: 1px solid rgb(255 255 255 / .12);
    color: var(--ink-body-on-dark);
  }
  .nav__inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1.2rem;
    min-height: 60px;
    flex-wrap: wrap;
  }
  

  .nav__brand { display: flex; align-items: center; flex-shrink: 0; }
  .nav__brand img { display: block; width: auto; height: 34px; }
  .nav-toggle { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .nav-toggle-label {
    order: 2;
    width: 44px; height: 44px;
    display: grid; place-items: center;
    cursor: pointer;
  }
  .nav-toggle-label span,
  .nav-toggle-label span::before,
  .nav-toggle-label span::after {
    content: ''; display: block;
    width: 22px; height: 2px;
    background: var(--ink-body-on-dark);
    position: relative;
  }
  .nav-toggle-label span::before { position: absolute; top: -7px; }
  .nav-toggle-label span::after  { position: absolute; top: 7px; }

  .nav-center { display: none; order: 4; width: 100%; }
  .nav-toggle:checked ~ .nav-center { display: block; }
  .nav-center ul { list-style: none; margin: 0; padding: 0 0 1.2rem; }
  .nav-center a {
    display: block; padding: 1rem 0;
    color: var(--ink-body-on-dark); font-weight: 500;
    border-bottom: 1px solid rgb(255 255 255 / .14);
  }
  .nav-center li:last-child a { border-bottom: 0; }
  


  .nav__cta {
    order: 3;
    padding-inline: 2rem;
    font-size: 1.4rem;
    white-space: nowrap;
  }

  
  .nav-rating {
    display: none;
    align-items: center;
    gap: .8rem;
    margin-right: 1.2rem;
  }
  .nav-rating__stars {
    color: var(--color-star);
    font-size: 1.4rem;
    letter-spacing: .08em;
    line-height: 1;
  }
  .nav-rating__text { display: grid; line-height: 1.2; }
  .nav-rating__text strong {
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: .04em;
  }
  

  .nav-rating__text span {
    font-size: 1.1rem;
    color: rgb(255 255 255 / .72);
  }

  
  .popup-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.3;
    font-weight: 400;
    margin: .35em 0 1.6rem;
  }
  .popup-sub {
    font-size: 1.4rem;
    color: var(--ink-muted);
    margin: 0 0 1.6rem;
  }
  .popup-note {
    font-size: 1.1rem;
    margin-top: 1.6rem;
  }

  .nav-toggle:focus-visible ~ .nav-toggle-label {
    outline: 2px solid var(--ink-body-on-dark); outline-offset: 2px;
  }

  @media (min-width: 900px) {
    .nav__brand img { height: 42px; }
    .nav-toggle-label { display: none; }
    .nav-center { display: block; order: 2; width: auto; }
    .nav-center ul { display: flex; gap: 2.4rem; padding: 0; }
    .nav-center a { padding: 0; border-bottom: 0; }
    .nav-rating { order: 3; display: flex; }
    .nav__cta { order: 4; }
    
    .nav__inner { flex-wrap: nowrap; }
  }

  @media (prefers-reduced-motion: reduce) {
    .topbar__inner > span:last-child::before { animation: none; }
  }
</style>

<script>
  const navToggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
  if (navToggle) {
    const sync = () => navToggle.setAttribute('aria-expanded', String(navToggle.checked));
    sync();
    navToggle.addEventListener('change', sync);
    navToggle.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      navToggle.checked = !navToggle.checked;
      navToggle.dispatchEvent(new Event('change'));
    });
  }

  const popup = document.getElementById('form-popup');
  if (popup) {
    let opener: HTMLElement | null = null;
    let wasOpen = location.hash === '#form-popup';

    document.addEventListener('click', (e) => {
      if (!(e.target instanceof Element)) return;
      const link = e.target.closest('a[href="#form-popup"]');
      if (link) opener = link as HTMLElement;
    });

    const focusFirst = () => {
      (popup.querySelector<HTMLElement>('input:not([type="hidden"]), select, textarea') ??
        popup.querySelector<HTMLElement>('button, a'))?.focus();
    };

    window.addEventListener('hashchange', () => {
      const isOpen = location.hash === '#form-popup';
      if (isOpen) focusFirst();
      // Solo al cerrar ESTE popup: un ancla de la página no roba el foco.
      else if (wasOpen && opener) opener.focus();
      wasOpen = isOpen;
    });

    if (location.hash === '#form-popup') focusFirst();

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && location.hash === '#form-popup') {
        history.replaceState(null, '', location.pathname + location.search);
        wasOpen = false;
        opener?.focus();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || location.hash !== '#form-popup') return;
      const list = [...popup.querySelectorAll<HTMLElement>('a[href], button, input, select, textarea')]
        .filter((el) => el.offsetParent !== null && el.tabIndex >= 0);
      if (!list.length) return;
      const first = list[0];
      const last = list[list.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }
</script>
