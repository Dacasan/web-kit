---
// UploadCase — "sube tu pano y tu presupuesto" en la página de gracias.
//
// Por qué vive aquí y no antes del envío: pedir una radiografía a alguien
// que todavía no ha dado su nombre es pedir demasiado pronto. En la página
// de gracias ya dio el paso, ya tiene su estimado delante y la pregunta
// cambia de "¿me interesa?" a "¿cuánto en MI caso?". Ese es el momento en
// que subir un archivo cuesta poco.
//
// El email se vuelve a pedir porque es la CLAVE con la que el CRM adjunta
// los archivos al lead que se acaba de crear. Viene rellenado desde
// sessionStorage (estimate-result.ts) para que un dedazo no deje los
// archivos huérfanos, pero el campo está visible y es editable.
//
// Si el endpoint falla, el bloque cae a WhatsApp: alguien que ya se decidió
// a mandar su radiografía no se puede quedar sin vía.
import { UPLOAD, PRICE_LOCK_UNTIL, whatsappHref, site } from '@agenciaweb/kit-site';

interface Props {
  /** Ancla de navegación: sin esto ningún CTA puede apuntar aquí. */
  id?: string;
  label?: string;
  title?: string;
  /** Cola del titular, en cursiva dorada. */
  titleAccent?: string;
  text?: string;
  cta?: string;
  fine?: string;
}

const {
  id,
  label = 'Ready when you are',
  title = 'Want the real number? Send your pano and your US quote.',
  titleAccent = `Locked until ${PRICE_LOCK_UNTIL}.`,
  text = 'We reply within 24 hours with what you need, what you don’t, and a fixed price in writing. No sales call.',
  cta = 'Send my files',
  fine = `Up to ${UPLOAD.maxFiles} files, ${UPLOAD.maxSizeMb} MB each. X-rays, photos or a PDF of your quote. HIPAA-aware intake — used only to price your case.`,
} = Astro.props;
---

<section
  id={id}
  class="section bg-dark"
  data-upload
  data-endpoint={UPLOAD.endpoint}
  data-max-size={UPLOAD.maxSizeMb}
  data-max-files={UPLOAD.maxFiles}
  data-wa={whatsappHref}
>
  <div class="container">
    <div class="row is-vertical-align">
      <div class="col-6-md">
        <p class="label">{label}</p>
        <h2 class="upload-title">
          {title} <em class="upload-title__accent">{titleAccent}</em>
        </h2>
        <p class="lead text-white upload-text">{text}</p>
      </div>

      <div class="col-6-md">
        <form class="upload-form" data-upload-form novalidate>
          <p class="form__error" id="upload-error" role="alert" tabindex="-1" hidden></p>

          <div class="field">
            <label class="form-label upload-label" for="upload-email">Your email *</label>
            <input
              id="upload-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              maxlength="120"
              required
              placeholder="alex@email.com"
              data-upload-email
            />
            <p class="upload-hint">We attach the files to your case with this.</p>
          </div>

          <div class="field">
            <label class="form-label upload-label" for="upload-files">Pano, X-rays or your quote *</label>
            <input
              id="upload-files"
              name="files"
              type="file"
              multiple
              accept={UPLOAD.accept}
              required
            />
            <p class="upload-hint" data-upload-list hidden></p>
          </div>

          <button type="submit" class="button primary upload-submit">{cta}</button>
          <p class="upload-fine">{fine}</p>

          {/* Salida de emergencia: solo aparece si el envío falla. */}
          <p class="upload-fallback" data-upload-fallback hidden>
            Upload didn’t go through. <a href={whatsappHref} target="_blank" rel="noopener" data-wa-cta>Send them on WhatsApp</a> or email {site.email}.
          </p>
        </form>

        {/* Confirmación: sustituye al formulario tras un envío correcto. */}
        <div class="upload-done" data-upload-done tabindex="-1" hidden>
          <p class="upload-done__icon" aria-hidden="true">✓</p>
          <h3 class="upload-done__title">Got them.</h3>
          <p class="text-white">{site.author.name} reviews your case personally. You’ll have your written plan and fixed price within 24 hours.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .upload-title { margin-top: 0; }
  /* Sección oscura: --primary se apaga contra el fondo, así que entra la
     variante que sí se lee sobre oscuro. No es el acento: el acento es
     superficie de CTA, nunca tinta. */
  .upload-title__accent { color: var(--ink-primary-on-dark); }
  .upload-text { max-width: 46ch; }

  /* Los campos viven sobre fondo oscuro: el borde del sistema
     (--border-field, casi negro) sería invisible aquí. */
  .upload-form :is(input, select) {
    background: transparent;
    color: var(--ink-body-on-dark);
    border-color: color-mix(in srgb, var(--ink-body-on-dark) 35%, transparent);
  }
  .upload-form :is(input, select)::placeholder {
    color: color-mix(in srgb, var(--ink-body-on-dark) 45%, transparent);
  }
  .upload-form :is(input, select):focus {
    border-color: var(--ink-body-on-dark);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 30%, transparent);
  }
  .upload-form input[type="file"] { padding: 1.2rem 1rem; cursor: pointer; }
  .upload-form input[type="file"]::file-selector-button {
    margin-right: 1.2rem;
    padding: .6rem 1.2rem;
    font: inherit;
    font-size: var(--text-xs);
    color: var(--ink-strong);
    background: var(--ink-body-on-dark);
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
  }

  .upload-label { color: var(--ink-title-on-dark); }
  .upload-hint {
    margin: .8rem 0 0;
    font-size: var(--text-xs);
    color: color-mix(in srgb, var(--ink-body-on-dark) 70%, transparent);
  }
  .upload-hint[hidden] { display: none; }
  .upload-submit { width: 100%; margin-top: .8rem; }
  .upload-fine {
    margin: 1.2rem 0 0;
    font-size: var(--text-xs);
    color: color-mix(in srgb, var(--ink-body-on-dark) 70%, transparent);
  }
  .upload-fallback { margin: 1.2rem 0 0; font-size: var(--text-sm); }
  .upload-fallback[hidden] { display: none; }
  .upload-fallback a { color: var(--ink-title-on-dark); text-decoration: underline; }

  .upload-done[hidden] { display: none; }
  .upload-done__icon {
    display: grid; place-items: center;
    width: 56px; height: 56px;
    margin: 0 0 1.6rem;
    font-size: var(--text-xl);
    color: var(--ink-strong);
    background: var(--ink-title-on-dark);
    border-radius: 50%;
  }
  .upload-done__title { margin-top: 0; }
</style>

<script>
  import '../../scripts/upload-case';
</script>
