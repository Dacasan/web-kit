---
import { site, whatsappHref, PAGINAS, HERRAMIENTAS } from '@agenciaweb/kit-site';

const titulo = (slug: string) =>
  slug.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());

const F = (site as { legalNote?: string; footerTitles?: Record<string, string> });
const legalNote = F.legalNote ?? "Results vary depending on each case. This page is informational and does not replace a professional consultation.";
const footTitle = (slug: string) => F.footerTitles?.[slug] ?? titulo(slug);
const homeLabel = F.footerTitles?.home ?? "Home";
const privacyLabel = F.footerTitles?.["privacy-policy"] ?? "Privacy Policy";
const termsLabel = F.footerTitles?.["terms"] ?? "Terms and Conditions";


---

<footer class="section section--tight bg-dark">
  <div class="container">
    


    <nav class="footer-map" aria-label="All pages">
      <ul class="footer-map__list">
        <li><a href="/" class="text-white">{homeLabel}</a></li>
        {PAGINAS.map((slug) => (
          <li><a href={`/${slug}/`} class="text-white">{footTitle(slug)}</a></li>
        ))}
      </ul>
      <ul class="footer-map__list footer-map__list--tools">
        {HERRAMIENTAS.map((slug) => (
          <li><a href={`/${slug}`} class="text-white" rel="nofollow">{footTitle(slug)}</a></li>
        ))}
      </ul>
    </nav>

  <div class="text-center">
    




    <p class="footer-name">
      <img
        src={site.logoDark ?? site.logo}
        alt={site.name}
        width="520"
        height="147"
        loading="lazy"
        decoding="async"
      />
    </p>
    <p class="footer-address">
      {site.address.street}, {site.address.locality}, {site.address.region}
    </p>
    <p class="footer-contact">
      <a href={`tel:${site.phone.replace(/\s/g,"")}`} class="text-white">{site.phone}</a>
      <span aria-hidden="true"> · </span>
      <a href={`mailto:${site.email}`} class="text-white">{site.email}</a>
    </p>
    <p class="footer-wa">
      <a
        href={whatsappHref}
        class="text-white"
        target="_blank"
        rel="noopener"
        data-wa-cta
        data-track="whatsapp_click"
        data-track-label="footer"
      >
        WhatsApp
      </a>
    </p>
    <p class="footer-legal">
      {legalNote}
    </p>
    <p class="footer-legal">
      <a href="/privacy-policy/">{privacyLabel}</a> · <a href="/terms/">{termsLabel}</a>
    </p>
  </div>
  </div>
</footer>

<style>
  .footer-map { margin-bottom: 4.8rem; }
  .footer-map__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .8rem 2.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--text-sm);
  }
  .footer-map__list--tools {
    margin-top: 2.4rem;
    padding-top: 2.4rem;
    border-top: 1px solid rgb(255 255 255 / .12);
    font-size: var(--text-xs);
    opacity: .7;
  }

  .footer-name { margin-bottom: 1.6rem; }
  .footer-name img {
    display: block;
    width: auto;
    height: 44px;
    margin-inline: auto;
  }
  .footer-address { font-size: var(--text-sm); }
  .footer-contact {
    font-size: var(--text-sm);
    margin-top: 1.6rem;
  }
  .footer-wa { font-size: var(--text-sm); }
  .footer-legal {
    font-size: var(--text-xs);
    margin-top: 2.4rem;
  }
  

  .footer-map__list a,
  .footer-legal a,
  .footer-contact a,
  .footer-wa a {
    display: inline-block;
    padding-block: .4rem;
  }
</style>
